{
  "name": "api",
  "version": "1.0.0",
  "private": true,

  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },

  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },

  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
